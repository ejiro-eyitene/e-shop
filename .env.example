# ---- Database (Neon) ----
# Neon Console -> Connection Details -> "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth.js ----
# Generate with: npx auth secret
AUTH_SECRET=replace-me-with-a-random-32-byte-string
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js trusts AUTH_URL over the real request origin. If it does not match
# the port you serve on, Google redirects back to a dead port and sign-in
# fails with a 404. Must match the authorized redirect URI in Google Cloud
# Console, e.g. http://localhost:3000/api/auth/callback/google
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ---- Mailgun ----
# Mailgun dashboard -> Sending -> Domain settings
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM="Shop <no-reply@yourdomain.com>"

# ---- Paystack ----
# Paystack dashboard -> Settings -> API Keys
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Public origin of the app. Needed in production so Paystack redirects back to
# the correct domain. Leave blank for local dev (derived from the request).
NEXT_PUBLIC_APP_URL=